# Copie para backend/.env. Não commite o arquivo preenchido.
# A service role só é usada pelo comando npm run seed. A API em execução não lê essa chave.

NODE_ENV=development
HOST=127.0.0.1
PORT=3333
APP_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=false

# Project Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=

# Project Settings → API → service_role. Só para npm run seed.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings → Database → URI. Só para aplicar database/supabase.sql.
SUPABASE_DB_URL=
